{
  "title": "AgentKube — Agent Execution & Worker Metrics",
  "tags": ["agentkube", "execution"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Task State Transitions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(agent_tasks_total[1m])) by (status)",
          "legendFormat": "Status {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Worker Tasks",
      "type": "stat",
      "targets": [
        {
          "expr": "agent_active_tasks",
          "legendFormat": "Executing Tasks"
        }
      ]
    },
    {
      "id": 3,
      "title": "Task Execution Duration (p50 / p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(agent_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Duration"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_task_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Duration"
        }
      ]
    }
  ]
}
