{
  "title": "AgentKube — K8s Infrastructure & Hardware",
  "tags": ["agentkube", "k8s"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Pod CPU Utilization (cores)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"agent-platform\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pod Memory Usage (bytes)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"agent-platform\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Container Restarts",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"agent-platform\"})",
          "legendFormat": "Total Restarts"
        }
      ]
    }
  ]
}
